{
  "schemaVersion": 1,
  "id": "io.github.aomine-c2c.neiman",
  "name": "NEIMAN Autonomous OS",
  "version": "1.3.0",
  "author": "Aomine-c2c",
  "license": "MIT",
  "description": "Live NEIMAN Autonomous Organization bar widget, 14-state agent monitor, inline approval gates, and one-click full application installer for Omarchy Quattro.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "NEIMAN OS",
    "category": "AI & Automation",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "apiUrl": "http://127.0.0.1:8000",
      "pollIntervalSec": 10
    },
    "schema": [
      {
        "key": "apiUrl",
        "type": "string",
        "label": "NEIMAN API Endpoint",
        "defaultValue": "http://127.0.0.1:8000",
        "description": "Base URL for your local or remote NEIMAN FastAPI backend."
      },
      {
        "key": "pollIntervalSec",
        "type": "integer",
        "label": "Telemetry refresh interval (seconds)",
        "min": 5,
        "max": 120,
        "step": 5,
        "defaultValue": 10
      }
    ]
  }
}
